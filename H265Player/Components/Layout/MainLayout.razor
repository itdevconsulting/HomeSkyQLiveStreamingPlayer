@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="@GetShellClass()">
    <NavMenu IsCollapsed="_isSidebarCollapsed" OnToggleCollapse="ToggleSidebarCollapse" />
    <main class="@GetContentClass()">
        <div class="content-shell-body" @key="_routeKey">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _isSidebarCollapsed;
    private string _routeKey = string.Empty;

    protected override void OnInitialized()
    {
        _routeKey = NavigationManager.Uri;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleSidebarCollapse()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private string GetShellClass() => _isSidebarCollapsed ? "shell shell-collapsed" : "shell";

    private string GetContentClass()
    {
        var classes = "content-shell";
        if (IsWatchRoute)
        {
            classes += " content-shell-watch";
        }

        if (_isSidebarCollapsed)
        {
            classes += " content-shell-collapsed";
        }

        return classes;
    }

    private bool IsWatchRoute
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(_routeKey).Trim('/');
            return path.StartsWith("preset/", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _routeKey = e.Location;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
