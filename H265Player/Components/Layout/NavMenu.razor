@implements IDisposable
@inject DirectSkyQPresetStore PresetStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<aside class="@GetNavShellClass()">
    <div class="nav-header">
        @if (!IsCollapsed)
        {
            <div class="brand">
                <span class="brand-kicker">Blazor Server</span>
                <strong class="brand-title">H265 Player</strong>
            </div>
        }

        <div class="nav-header-actions">
            <a class="nav-header-link"
               href="@PublicRepoUrl"
               target="_blank"
               rel="noreferrer noopener"
               aria-label="Open public GitHub repository"
               title="Open public GitHub repository">
                <svg class="nav-header-link-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M12 .6a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.42-4.04-1.42-.55-1.38-1.34-1.75-1.34-1.75-1.09-.75.08-.73.08-.73 1.2.09 1.83 1.23 1.83 1.23 1.08 1.84 2.82 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.46-1.33-5.46-5.9 0-1.3.46-2.37 1.22-3.2-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.28 1.22a11.4 11.4 0 0 1 5.98 0c2.28-1.54 3.28-1.22 3.28-1.22.65 1.64.24 2.86.12 3.16.76.83 1.22 1.9 1.22 3.2 0 4.58-2.8 5.59-5.47 5.89.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .6Z" />
                </svg>
            </a>

            <button type="button"
                    class="nav-shell-toggle"
                    @onclick="ToggleSidebarAsync"
                    aria-label="@GetSidebarToggleLabel()"
                    title="@GetSidebarToggleLabel()">
                <span class="@GetSidebarToggleIconClass()" aria-hidden="true">
                    <span class="nav-shell-toggle-divider"></span>
                    <span class="nav-shell-toggle-arrow"></span>
                </span>
            </button>
        </div>
    </div>

    <div class="nav-scroll">
        <nav class="nav-links">
            <NavLink class="nav-link-main" href="/" Match="NavLinkMatch.All" title="Home">
                <span class="nav-icon nav-icon-home" aria-hidden="true"></span>
                <span class="nav-link-text">Home</span>
            </NavLink>

            <NavLink class="nav-link-main" href="/setup" title="Setup">
                <span class="nav-icon nav-icon-setup" aria-hidden="true"></span>
                <span class="nav-link-text">Setup</span>
            </NavLink>

            <div class="@GetPlayersGroupClass()">
                <button type="button"
                        class="@GetPlayersToggleClass()"
                        @onclick="TogglePlayersExpanded"
                        aria-expanded="@IsPlayersMenuOpen"
                        title="Players">
                    <span class="nav-icon nav-icon-players" aria-hidden="true"></span>
                    <span class="nav-link-text">Players</span>
                    <span class="@GetChevronClass(_playersExpanded)" aria-hidden="true"></span>
                </button>

                @if (!IsCollapsed)
                {
                    <div class="@GetPlayersSubLinksClass()">
                        <NavLink class="nav-link-sub" href="/direct">Direct</NavLink>
                        <NavLink class="nav-link-sub" href="/ffmpeg">FFmpeg</NavLink>
                        <NavLink class="nav-link-sub" href="/rtsp">RTSP</NavLink>
                        <NavLink class="nav-link-sub" href="/hls">HLS</NavLink>
                        <NavLink class="nav-link-sub" href="/engines">Engines</NavLink>
                    </div>
                }
                else if (_playersFlyoutOpen)
                {
                    <div class="nav-flyout nav-flyout-open">
                        <NavLink class="nav-link-sub" href="/direct">Direct</NavLink>
                        <NavLink class="nav-link-sub" href="/ffmpeg">FFmpeg</NavLink>
                        <NavLink class="nav-link-sub" href="/rtsp">RTSP</NavLink>
                        <NavLink class="nav-link-sub" href="/hls">HLS</NavLink>
                        <NavLink class="nav-link-sub" href="/engines">Engines</NavLink>
                    </div>
                }
            </div>

            <NavLink class="nav-link-main" href="/skyq" title="Sky Q">
                <span class="nav-icon nav-icon-remote" aria-hidden="true"></span>
                <span class="nav-link-text">Sky Q</span>
            </NavLink>

            <NavLink class="nav-link-main" href="/skystream" title="Sky Stream">
                <span class="nav-icon nav-icon-remote" aria-hidden="true"></span>
                <span class="nav-link-text">Sky Stream</span>
            </NavLink>

            <NavLink class="@GetPresetsNavClass()" href="/presets" title="Preset Manager">
                <span class="nav-icon nav-icon-grid" aria-hidden="true"></span>
                <span class="nav-link-text">Preset Manager</span>
            </NavLink>
        </nav>

        @if (_isAuthenticated && !_isTrusted)
        {
            <div class="nav-auth-block">
                @if (IsCollapsed)
                {
                    <button type="button"
                            class="nav-inline-button nav-inline-icon-button"
                            @onclick="LogoutAsync"
                            title="@GetCollapsedLogoutTitle()">
                        <span class="nav-inline-icon nav-inline-icon-logout" aria-hidden="true"></span>
                    </button>
                }
                else
                {
                    <span class="brand-kicker">Session</span>
                    <span class="nav-session-user">@_userName</span>
                    <button type="button" class="nav-inline-button" @onclick="LogoutAsync">Logout</button>
                }
            </div>
        }

        @if (!IsCollapsed)
        {
            <div class="nav-presets">
                <span class="brand-kicker">Presets</span>
                @if (_presets.Count == 0)
                {
                    <span class="nav-preset-empty">No saved presets</span>
                }
                else
                {
                    @foreach (var preset in _presets)
                    {
                        <NavLink class="nav-preset-link" href="@($"/preset/{preset.Id}")">@preset.Name</NavLink>
                    }
                }
            </div>
        }
    </div>
</aside>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    private const string PublicRepoUrl = "https://github.com/itdevconsulting/HomeSkyQLiveStreamingPlayer";

    private IReadOnlyList<DirectSkyQPreset> _presets = [];
    private bool _isTrusted;
    private bool _isAuthenticated;
    private string _userName = string.Empty;
    private bool _playersExpanded = true;
    private bool _playersFlyoutOpen;
    private string _relativePath = string.Empty;

    protected override void OnInitialized()
    {
        LoadPresets();
        PresetStore.Changed += OnPresetsChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateRouteState();
    }

    protected override void OnParametersSet()
    {
        if (!IsCollapsed)
        {
            _playersFlyoutOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            var status = await client.GetFromJsonAsync<AuthStatusResponse>("/api/auth/status");
            if (status is null)
            {
                return;
            }

            _isTrusted = status.TrustedNetwork || status.UnauthenticatedAccess;
            _isAuthenticated = status.IsAuthenticated;
            _userName = status.Email ?? string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private void LoadPresets()
    {
        _presets = PresetStore.GetAll();
    }

    private void OnPresetsChanged()
    {
        LoadPresets();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("h265Auth.logout");
        NavigationManager.NavigateTo("/auth/login", forceLoad: true);
    }

    private async Task ToggleSidebarAsync()
    {
        _playersFlyoutOpen = false;
        await OnToggleCollapse.InvokeAsync();
    }

    private void TogglePlayersExpanded()
    {
        if (IsCollapsed)
        {
            _playersFlyoutOpen = !_playersFlyoutOpen;
            return;
        }

        _playersExpanded = !_playersExpanded;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _playersFlyoutOpen = false;
        UpdateRouteState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateRouteState()
    {
        _relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/').ToLowerInvariant();
        if (IsPlayerRouteActive)
        {
            _playersExpanded = true;
        }
    }

    private bool IsPlayersMenuOpen => IsCollapsed ? _playersFlyoutOpen : _playersExpanded;

    private bool IsPlayerRouteActive =>
        _relativePath is "direct" or "ffmpeg" or "rtsp" or "hls" or "engines";

    private bool IsPresetRouteActive =>
        _relativePath == "presets" || _relativePath.StartsWith("preset/", StringComparison.Ordinal);

    private string GetNavShellClass() => IsCollapsed ? "nav-shell nav-shell-collapsed" : "nav-shell";

    private string GetSidebarToggleLabel() => IsCollapsed ? "Expand sidebar" : "Collapse sidebar";

    private string GetSidebarToggleIconClass() =>
        IsCollapsed ? "nav-shell-toggle-icon nav-shell-toggle-icon-collapsed" : "nav-shell-toggle-icon";

    private string GetPlayersGroupClass() => IsCollapsed ? "nav-group nav-group-collapsed" : "nav-group";

    private string GetPlayersToggleClass()
    {
        var classes = "nav-link-main nav-link-button";
        if (IsPlayerRouteActive || IsPlayersMenuOpen)
        {
            classes += " nav-link-force-active";
        }

        return classes;
    }

    private string GetPlayersSubLinksClass() =>
        _playersExpanded ? "nav-sub-links" : "nav-sub-links nav-sub-links-collapsed";

    private string GetPresetsNavClass()
    {
        var classes = "nav-link-main";
        if (IsPresetRouteActive)
        {
            classes += " nav-link-force-active";
        }

        return classes;
    }

    private static string GetChevronClass(bool expanded) =>
        expanded ? "nav-group-chevron nav-group-chevron-expanded" : "nav-group-chevron";

    private string GetCollapsedLogoutTitle() =>
        string.IsNullOrWhiteSpace(_userName) ? "Logout" : $"Logout {_userName}";

    public void Dispose()
    {
        PresetStore.Changed -= OnPresetsChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
