@page "/"
@inject IJSRuntime JS
@inject LocalSetupStore LocalSetupStore

<PageTitle>Home</PageTitle>

<section class="panel home-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">Home</p>
            <h1>Stream Lab</h1>
            <p class="lede">This is the default landing page for the Blazor Server app. Use the navigation to open the direct decoder, managed FFmpeg, or HLS playback pages.</p>
        </div>
        <PageInfo Title="Home" Summary="Use this page to choose the right playback or control path before you start testing." Items="HomeHelpItems" />
    </div>
    <div class="status-grid">
        <div>
            <span class="label">App Base URL</span>
            <code>@NavigationManager.BaseUri</code>
        </div>
        <div>
            <span class="label">FFmpeg Setup</span>
            <code>@(LocalSetupStore.IsConfigured() ? "Configured" : "Required")</code>
        </div>
        <div>
            <span class="label">Access</span>
            <code>@AccessStatus</code>
            @if (ShowLogout)
            {
                <button type="button" class="home-logout-button" @onclick="LogoutAsync">Logout</button>
            }
        </div>
    </div>

    <div class="setup-service-grid">
        <div class="panel-copy">
            <p class="eyebrow">Service</p>
            <h2>Streaming Service</h2>
            <p class="lede">Use this if the proxy path wedges and you need the installed service to reconnect. The restart control only lights up when the current host mode supports self-restart.</p>
        </div>

        @if (_serviceRestartStatus is not null)
        {
            <div class="setup-status @(_serviceRestartStatus.CanSelfRestart ? "configured" : "missing")">
                <strong>@ServiceRestartHeading</strong>
                <span>@_serviceRestartStatus.Message</span>
                <span class="setup-status-meta">Mode: @_serviceRestartStatus.ServiceMode</span>
            </div>
        }

        <div class="toolbar">
            <button type="button" disabled="@RestartButtonDisabled" @onclick="RestartStreamingServiceAsync">@RestartButtonText</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="setup-inline-error">@ErrorText</div>
        }
        @if (!string.IsNullOrWhiteSpace(SuccessText))
        {
            <div class="setup-inline-success">@SuccessText</div>
        }
    </div>

    @if (_updateStatus is not null)
    {
        <div class="setup-service-grid">
            <div class="panel-copy">
                <p class="eyebrow">Updates</p>
                <h2>GitHub Auto-Update</h2>
                <p class="lede">The installed service can check the public GitHub repo and queue the same installer used for first-time setup. Automatic install is optional and can be turned on from Setup.</p>
            </div>

            <div class="setup-status @UpdateStatusClass">
                <strong>@UpdateHeading</strong>
                <span>@_updateStatus.Message</span>
                <span class="setup-status-meta">Installed: @FormatVersion(_updateStatus.Current)</span>
                <span class="setup-status-meta">GitHub: @FormatVersion(_updateStatus.Latest)</span>
                <span class="setup-status-meta">Auto-update: @(_updateStatus.AutoUpdateEnabled ? "On" : "Off")</span>
            </div>

            <div class="toolbar">
                <button type="button" disabled="@_updateBusy" @onclick="CheckForUpdateAsync">@CheckButtonText</button>
                <button type="button" disabled="@UpdateButtonDisabled" @onclick="ApplyUpdateAsync">@UpdateButtonText</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(UpdateErrorText))
            {
                <div class="setup-inline-error">@UpdateErrorText</div>
            }
            @if (!string.IsNullOrWhiteSpace(UpdateSuccessText))
            {
                <div class="setup-inline-success">@UpdateSuccessText</div>
            }
        </div>
    }

    <div class="home-grid">
        <a class="home-card" href="/setup">
            <strong>Setup</strong>
            <span>Configure the local FFmpeg executable and optional machine defaults before using managed playback pages.</span>
        </a>
        <a class="home-card" href="/direct">
            <strong>Direct</strong>
            <span>Original proxy + browser decoder flow for raw TS input.</span>
        </a>
        <a class="home-card" href="/ffmpeg">
            <strong>FFmpeg</strong>
            <span>Managed transcoding inside the app with saved settings and restart logic.</span>
        </a>
        <a class="home-card" href="/rtsp">
            <strong>RTSP</strong>
            <span>Managed RTSP ingest via FFmpeg with browser playback from the generated HLS output.</span>
        </a>
        <a class="home-card" href="/hls">
            <strong>HLS</strong>
            <span>Playlist playback with `hls.js` and optional same-origin proxy rewriting.</span>
        </a>
        <a class="home-card" href="/engines">
            <strong>Engines</strong>
            <span>Compare alternate JS player libraries for TS and HLS without changing the main pages.</span>
        </a>
        <a class="home-card" href="/skyq">
            <strong>Sky Q</strong>
            <span>Scan connected private subnets for Sky Q boxes and control them from a browser-based remote.</span>
        </a>
        <a class="home-card" href="/skystream">
            <strong>Sky Stream</strong>
            <span>Control Sky Stream from the UK-egress gateway box beside the puck (mTLS WebSocket on port 8091). Open the UI over Tailscale; keep the puck on its own gateway.</span>
        </a>
        <a class="home-card" href="/presets">
            <strong>Presets</strong>
            <span>Save named stream + Sky Q or Sky Stream combinations and launch them from the left navigation.</span>
        </a>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<string> HomeHelpItems =
    [
        "Direct is the simplest raw stream test page for HTTP MPEG-TS input.",
        "Setup configures the local FFmpeg path once for this machine. The managed FFmpeg, RTSP, and managed preset paths depend on it.",
        "Streaming Service exposes a restart control on the home page for installed service deployments that support self-restart.",
        "GitHub Auto-Update compares this install with the public repo and can queue the Linux or Windows installer to replace the running service.",
        "Turn on automatic updates from Setup if you want the installed service to apply a newer GitHub commit without clicking Install update.",
        "FFmpeg and RTSP are the managed server-side paths. They use the saved FFmpeg settings and generate browser-friendly HLS output.",
        "HLS is the straightforward browser page for .m3u8 playback with optional proxy rewriting.",
        "Engines is the comparison page for trying different browser player libraries against the same stream.",
        "Sky Q is separate from video playback. It scans the local private network for Sky Q boxes and exposes remote control buttons.",
        "Sky Stream needs TCP 8091 on the puck’s LAN. Install this service on the UK-egress gateway box; use Tailscale only to reach the web UI. Do not change the puck’s gateway."
    ];

    private string AccessStatus { get; set; } = "Loading";
    private string ErrorText { get; set; } = string.Empty;
    private string SuccessText { get; set; } = string.Empty;
    private bool ShowLogout { get; set; }
    private ServiceRestartStatusResponse? _serviceRestartStatus;
    private bool _serviceRestartBusy;
    private AppUpdateStatusResponse? _updateStatus;
    private bool _updateBusy;
    private string UpdateErrorText { get; set; } = string.Empty;
    private string UpdateSuccessText { get; set; } = string.Empty;

    private bool RestartButtonDisabled =>
        _serviceRestartBusy || _serviceRestartStatus is not { CanSelfRestart: true, RestartScheduled: false };

    private string RestartButtonText =>
        _serviceRestartBusy
            ? "Restarting..."
            : _serviceRestartStatus?.RestartScheduled == true
                ? "Restart queued"
                : "Restart streaming service";

    private string ServiceRestartHeading =>
        _serviceRestartStatus?.RestartScheduled == true
            ? "Restart pending"
            : _serviceRestartStatus?.CanSelfRestart == true
                ? "Self-restart ready"
                : "Self-restart unavailable";

    private bool UpdateButtonDisabled =>
        _updateBusy || _updateStatus is not { CanApply: true, UpdateQueued: false } ||
        _updateStatus is { UpdateAvailable: false };

    private string CheckButtonText =>
        _updateBusy ? "Checking..." : "Check for updates";

    private string UpdateButtonText =>
        _updateStatus?.UpdateQueued == true
            ? "Update queued"
            : "Install update";

    private string UpdateHeading =>
        _updateStatus?.UpdateQueued == true
            ? "Update queued"
            : _updateStatus?.UpdateAvailable == true
                ? "Update available"
                : _updateStatus?.CanApply == true
                    ? "Up to date"
                    : "Helper not installed";

    private string UpdateStatusClass =>
        _updateStatus is { UpdateQueued: true } or { UpdateAvailable: true }
            ? "missing"
            : _updateStatus is { CanApply: true }
                ? "configured"
                : "missing";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            var status = await client.GetFromJsonAsync<AuthStatusResponse>("/api/auth/status");
            if (status is null)
            {
                AccessStatus = "Unknown";
            }
            else
            {
                AccessStatus = status.TrustedNetwork
                    ? "Trusted network"
                    : status.UnauthenticatedAccess
                        ? "Unauthenticated port"
                    : status.IsAuthenticated
                        ? string.IsNullOrWhiteSpace(status.Email)
                            ? "Authenticator session"
                            : $"Authenticator session ({status.Email})"
                    : "External login required";
                ShowLogout = status.IsAuthenticated && !status.TrustedNetwork;
                if (status.UnauthenticatedAccess)
                {
                    ShowLogout = false;
                }
            }
        }
        catch
        {
            AccessStatus = "Unknown";
        }

        await LoadServiceRestartStatusAsync();
        await LoadUpdateStatusAsync(forceRefresh: false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("h265Auth.logout");
        NavigationManager.NavigateTo("/auth/login", forceLoad: true);
    }

    private async Task LoadServiceRestartStatusAsync()
    {
        var serviceResponse = await JS.InvokeAsync<ApiEnvelope<ServiceRestartStatusResponse>>("h265Auth.fetchJson", "/api/service/status");
        if (serviceResponse.Ok && serviceResponse.Json is not null)
        {
            _serviceRestartStatus = serviceResponse.Json;
            return;
        }

        if (serviceResponse.Status == StatusCodes.Status403Forbidden)
        {
            return;
        }

        ErrorText = string.IsNullOrWhiteSpace(serviceResponse.Text)
            ? "Unable to load restart status."
            : serviceResponse.Text;
    }

    private async Task RestartStreamingServiceAsync()
    {
        ErrorText = string.Empty;
        SuccessText = string.Empty;

        if (RestartButtonDisabled)
        {
            return;
        }

        _serviceRestartBusy = true;

        try
        {
            var response = await JS.InvokeAsync<ApiEnvelope<ServiceRestartStatusResponse>>("h265Auth.fetchJson", "/api/service/restart", new
            {
                method = "POST"
            });

            if (response.Json is not null)
            {
                _serviceRestartStatus = response.Json;
            }

            if (!response.Ok)
            {
                ErrorText = response.Json?.Message ?? response.Text;
                return;
            }

            SuccessText = _serviceRestartStatus?.Message ?? "Restart requested. Reload the page in a few seconds if it does not reconnect on its own.";
        }
        finally
        {
            _serviceRestartBusy = false;
        }
    }

    private async Task LoadUpdateStatusAsync(bool forceRefresh)
    {
        var response = forceRefresh
            ? await JS.InvokeAsync<ApiEnvelope<AppUpdateStatusResponse>>("h265Auth.fetchJson", "/api/update/check", new { method = "POST" })
            : await JS.InvokeAsync<ApiEnvelope<AppUpdateStatusResponse>>("h265Auth.fetchJson", "/api/update/status");
        if (response.Ok && response.Json is not null)
        {
            _updateStatus = response.Json;
            return;
        }

        if (response.Status == StatusCodes.Status403Forbidden)
        {
            return;
        }

        UpdateErrorText = string.IsNullOrWhiteSpace(response.Text)
            ? "Unable to load update status."
            : response.Text;
    }

    private async Task CheckForUpdateAsync()
    {
        UpdateErrorText = string.Empty;
        UpdateSuccessText = string.Empty;
        _updateBusy = true;
        try
        {
            await LoadUpdateStatusAsync(forceRefresh: true);
            if (_updateStatus is not null)
            {
                UpdateSuccessText = _updateStatus.Message;
            }
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task ApplyUpdateAsync()
    {
        UpdateErrorText = string.Empty;
        UpdateSuccessText = string.Empty;
        if (UpdateButtonDisabled)
        {
            return;
        }

        _updateBusy = true;
        try
        {
            var response = await JS.InvokeAsync<ApiEnvelope<AppUpdateStatusResponse>>("h265Auth.fetchJson", "/api/update/apply", new
            {
                method = "POST"
            });

            if (response.Json is not null)
            {
                _updateStatus = response.Json;
            }

            if (!response.Ok)
            {
                UpdateErrorText = response.Json?.Message ?? response.Text;
                return;
            }

            UpdateSuccessText = _updateStatus?.Message ?? "Update queued. The page will disconnect while the service is replaced.";
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private static string FormatVersion(AppVersionSummary? version)
    {
        if (version is null)
        {
            return "Unknown";
        }

        var calendar = version.Version
            ?? (version.Timestamp is { } timestamp ? AppRelease.FromTimestamp(timestamp) : null)
            ?? "unknown";
        return string.IsNullOrWhiteSpace(version.Message)
            ? $"{calendar} ({version.ShortSha})"
            : $"{calendar} ({version.ShortSha}) {version.Message}";
    }

    private sealed class ApiEnvelope<T>
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Text { get; set; } = string.Empty;
        public T? Json { get; set; }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
