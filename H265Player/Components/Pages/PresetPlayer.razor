@page "/preset/{Id:guid}"
@implements IDisposable
@inject IJSRuntime JS
@inject DirectSkyQPresetStore PresetStore
@inject SkyQService SkyQService
@inject SkyStreamService SkyStreamService
@inject NavigationManager NavigationManager
@inject LocalSetupStore LocalSetupStore

<PageTitle>Preset Player</PageTitle>

@if (_preset is null)
{
    <section class="panel">
        <p class="eyebrow">Preset</p>
        <h1>Preset Not Found</h1>
        <p class="lede">The requested preset does not exist.</p>
    </section>
}
else
{
    <div class="watch-layout">
    <section class="panel preset-panel">
        <div class="preset-header">
            <div class="preset-header-toolbar">
                <div class="preset-icon-group">
                    <button type="button" class="preset-icon-button preset-icon-button-play" @onclick="GoAsync" title="Play">
                        <span class="play-icon" aria-hidden="true"></span>
                    </button>
                    <SkyQMiniRemote Title="@RemoteTitle"
                                    ButtonCssClass="preset-icon-button preset-icon-button-remote"
                                    PositionKey="preset-player"
                                    ShowLiveTv="@IsSkyStream"
                                    OnCommand="SendCommandAsync"
                                    OnLiveChannel="TuneLiveChannelAsync">
                        <ButtonContent>
                            <span class="remote-icon" aria-hidden="true">
                                <span class="remote-icon-screen"></span>
                                <span class="remote-icon-pad"></span>
                            </span>
                        </ButtonContent>
                    </SkyQMiniRemote>
                </div>
            </div>

            <label class="@GetBufferingControlClass()" title="@BufferingTitle">
                <span class="preset-buffer-label">Buf</span>
                <input type="range"
                       class="preset-buffer-slider"
                       min="1"
                       max="5"
                       step="1"
                       value="@_bufferingLevel"
                       style="@GetBufferingSliderStyle()"
                       disabled="@(!SupportsAdjustableBuffering)"
                       @oninput="OnBufferingInput"
                       @onchange="OnBufferingCommittedAsync" />
                <span class="preset-buffer-value">@_bufferingLevel</span>
            </label>

            <label class="preset-buffer-control" title="@VideoSizeTitle">
                <span class="preset-buffer-label">Size</span>
                <input type="range"
                       class="preset-buffer-slider preset-size-slider"
                       min="20"
                       max="100"
                       step="1"
                       value="@_videoScale"
                       style="@GetVideoSizeSliderStyle()"
                       @oninput="OnVideoSizeInputAsync" />
                <span class="preset-size-value">@VideoSizeLabel</span>
            </label>

            <div class="preset-header-main">
                <h2 class="preset-title">@_preset.Name</h2>
            </div>

            <PageInfo Title="Preset Player" Summary="This page opens the saved source type and binds it to the selected Sky Q or Sky Stream box." Items="HelpItems" />
        </div>
    </section>

    @if (RequiresSetup)
    {
        <section class="panel">
            <div class="setup-status missing">
                <strong>FFmpeg setup required</strong>
                <span>This preset uses the managed @_preset.SourceType.ToUpperInvariant() path. Configure FFmpeg before starting it.</span>
            </div>
            <div class="toolbar">
                <button type="button" @onclick="OpenSetup">Open setup</button>
            </div>
        </section>
    }
    else
    {
    <section class="player-panel preset-player-panel">
        <div id="preset-video-shell" class="preset-video-shell">
            <div class="preset-video-frame" style="@ManagedHostStyle">
                <StaticDomHost Id="preset-managed-host" CssClass="player-host" />
            </div>
            <div class="preset-video-frame" style="@VideoHostStyle">
                <StaticDomHost Id="preset-player-host" Kind="video" CssClass="video-host" Controls="true" PlaysInline="true" />
            </div>
        </div>
        <div class="preset-meta">
            <span><strong>@_preset.SourceType.ToUpperInvariant()</strong></span>
            <span>@RemoteTitle</span>
            <span>@_status</span>
            <span>@_lastCommand</span>
            <span class="preset-meta-url">@_preset.StreamUrl</span>
        </div>
    </section>
    }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private static readonly IReadOnlyList<string> HelpItems =
    [
        "Go tears down any existing player on this screen and starts the saved source again using its configured source type.",
        "Direct presets use the raw TS browser path, HLS presets use the HLS browser path, and FFmpeg or RTSP presets restart the managed transcoder before playing the output.",
        "Buffer sets one of five browser buffering presets for Direct and HLS playback. Higher values trade latency for stability.",
        "Size scales the picture from a small window up to Fit, which uses the remaining space beside the sidebar.",
        "Remote opens a draggable mini remote tied to the saved Sky Q or Sky Stream box for this preset.",
        "On Sky Stream presets, Live TV jumps to a channel through the Home menu instead of fighting the Stream remote.",
        "Keyboard arrows, numbers, Enter, Esc, and Space are captured only while that mini remote is on screen, so the video player keeps its own keys the rest of the time.",
        "Edit names, stream URLs, or box associations on the Presets page."
    ];

    private DirectSkyQPreset? _preset;
    private string _status = "Idle";
    private string _logText = string.Empty;
    private string _lastCommand = "None";
    private int _videoScale = 100;
    private int _bufferingLevel = 5;
    private bool _bufferingDirty;
    private bool _hasLoadedPlayer;
    private string _managedHostStyle = "display:none";
    private string _videoHostStyle = "";
    private bool _pendingAutoLoad;
    private DotNetObjectReference<PresetPlayer>? _dotNetRef;
    private bool RequiresSetup => _preset is { SourceType: "ffmpeg" or "rtsp" } && !LocalSetupStore.IsConfigured();
    private bool SupportsAdjustableBuffering => _preset is { SourceType: "direct" or "hls" };

    private bool IsSkyStream =>
        _preset is not null && SkyRemoteKinds.Normalize(_preset.RemoteKind) == SkyRemoteKinds.SkyStream;

    private string RemoteTitle =>
        _preset is null
            ? "Remote"
            : IsSkyStream
                ? string.IsNullOrWhiteSpace(_preset.SkyQHostName) ? "Sky Stream" : _preset.SkyQHostName
                : string.IsNullOrWhiteSpace(_preset.SkyQHostName) ? "Sky Q" : _preset.SkyQHostName;

    private string ManagedHostStyle => _managedHostStyle;
    private string VideoHostStyle => _videoHostStyle;
    private string BufferingLabel => _bufferingLevel switch
    {
        1 => "Min",
        2 => "Low",
        3 => "Med",
        4 => "High",
        _ => "Max"
    };
    private string BufferingTitle =>
        SupportsAdjustableBuffering
            ? $"Buffering {BufferingLabel} ({_bufferingLevel}/5)"
            : $"Buffering {BufferingLabel} ({_bufferingLevel}/5). Applies to Direct and HLS presets.";
    private string VideoSizeLabel => _videoScale >= 100 ? "Fit" : $"{_videoScale}%";
    private string VideoSizeTitle =>
        _videoScale >= 100
            ? "Video size Fit. Uses the remaining window space."
            : $"Video size {_videoScale}% of the remaining window space.";

    protected override void OnParametersSet()
    {
        _preset = PresetStore.Get(Id);
        _pendingAutoLoad = _preset is not null;
        _hasLoadedPlayer = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _videoScale = await JS.InvokeAsync<int>("h265App.getWatchVideoScale");
            }
            catch
            {
                _videoScale = 100;
            }

            await ApplyVideoSizeAsync();
            await InvokeAsync(StateHasChanged);
        }

        if (_preset is null || !_pendingAutoLoad || RequiresSetup)
        {
            return;
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);
        _pendingAutoLoad = false;
        await GoAsync();
    }

    private async Task GoAsync()
    {
        if (_preset is null || RequiresSetup)
        {
            return;
        }

        await ReleaseAsync();
        _logText = string.Empty;

        switch (_preset.SourceType)
        {
            case "hls":
                _managedHostStyle = "display:none";
                _videoHostStyle = "";
                var hlsResult = await JS.InvokeAsync<HlsLoadResult>("h265App.hlsLoadToElement", "preset-player-host", _preset.StreamUrl, _preset.UseHlsProxy, _bufferingLevel, BuildPlaybackWatchdogOptions());
                _status = hlsResult.Status;
                _logText = $"Starting {hlsResult.ResolvedUrl}";
                _hasLoadedPlayer = true;
                break;

            case "ffmpeg":
            case "rtsp":
                _managedHostStyle = "";
                _videoHostStyle = "display:none";
                await StartManagedPresetAsync();
                _hasLoadedPlayer = true;
                break;

            default:
                _managedHostStyle = "display:none";
                _videoHostStyle = "";
                var directResult = await JS.InvokeAsync<DirectLoadResult>("h265App.directLoadToElement", "preset-player-host", _preset.StreamUrl, _dotNetRef, _bufferingLevel, BuildPlaybackWatchdogOptions());
                _status = directResult.Status;
                _logText = $"Starting {directResult.ProxyUrl}";
                _hasLoadedPlayer = true;
                break;
        }

        await InvokeAsync(StateHasChanged);
        await ApplyVideoSizeAsync();
    }

    private async Task StartManagedPresetAsync()
    {
        if (_preset is null || RequiresSetup)
        {
            return;
        }

        var request = new StartRequest
        {
            Settings = new FfmpegSettings
            {
                InputUrl = _preset.StreamUrl,
                VideoCodec = string.IsNullOrWhiteSpace(_preset.VideoCodec) ? "libx264" : _preset.VideoCodec,
                Preset = string.IsNullOrWhiteSpace(_preset.Preset) ? "browser-safe-h264" : _preset.Preset,
                AudioMode = string.IsNullOrWhiteSpace(_preset.AudioMode) ? "none" : _preset.AudioMode,
                AutoRestart = _preset.AutoRestart,
                AutoPlay = _preset.AutoPlay,
                AutoStart = false
            }
        };

        var storedSettingsResponse = await JS.InvokeAsync<ApiEnvelope<FfmpegSettings>>("h265Auth.fetchJson", "/api/settings");
        var storedSettings = storedSettingsResponse.Json;
        request.Settings.FfmpegPath = storedSettings?.FfmpegPath ?? string.Empty;

        var response = await JS.InvokeAsync<ApiEnvelope<TranscoderStatusResponse>>("h265Auth.fetchJson", "/api/transcoder/start", new
        {
            method = "POST",
            body = System.Text.Json.JsonSerializer.Serialize(request)
        });
        if (!response.Ok)
        {
            _status = $"Start failed ({response.Status})";
            _logText = response.Text;
            return;
        }

        var status = response.Json;
        _status = status?.IsRunning == true ? "Running" : "Stopped";
        _logText = status?.Logs is { Count: > 0 } ? string.Join(Environment.NewLine, status.Logs) : "Managed stream started";
        await JS.InvokeVoidAsync("h265App.managedLoadToHost", "preset-managed-host", "/live/stream.m3u8", _preset.AutoPlay, _preset.AudioMode == "none");
    }

    private async Task ReleaseAsync()
    {
        await JS.InvokeVoidAsync("h265App.directReleaseElement", "preset-player-host");
        await JS.InvokeVoidAsync("h265App.hlsReleaseElement", "preset-player-host");
        await JS.InvokeVoidAsync("h265App.managedReleaseHost", "preset-managed-host");
    }

    private async Task SendCommandAsync(string command)
    {
        if (_preset is null)
        {
            return;
        }

        var result = IsSkyStream
            ? await SkyStreamService.SendCommandAsync(_preset.SkyQHost, command, CancellationToken.None)
            : await SkyQService.SendCommandAsync(_preset.SkyQHost, command, CancellationToken.None);
        _lastCommand = command;
        _logText = string.Join(Environment.NewLine, new[] { result.Message }.Concat(result.Logs));
        await InvokeAsync(StateHasChanged);
    }

    private async Task TuneLiveChannelAsync(int channelNumber)
    {
        if (_preset is null || !IsSkyStream)
        {
            return;
        }

        var result = await SkyStreamService.TuneLiveChannelAsync(_preset.SkyQHost, channelNumber, CancellationToken.None);
        _lastCommand = $"livetv {channelNumber}";
        _logText = string.Join(Environment.NewLine, new[] { result.Message }.Concat(result.Logs));
        await InvokeAsync(StateHasChanged);
    }

    private void OpenSetup()
    {
        NavigationManager.NavigateTo($"/setup?returnUrl={Uri.EscapeDataString($"/preset/{Id}")}");
    }

    private string GetBufferingControlClass() =>
        SupportsAdjustableBuffering ? "preset-buffer-control" : "preset-buffer-control preset-buffer-control-disabled";

    private string GetBufferingSliderStyle() => $"--buffer-fill:{(_bufferingLevel - 1) * 25}%;";

    private string GetVideoSizeSliderStyle() => $"--buffer-fill:{(_videoScale - 20) / 0.8}%;";

    private async Task OnVideoSizeInputAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var parsed))
        {
            return;
        }

        var normalized = Math.Clamp(parsed, 20, 100);
        if (normalized == _videoScale)
        {
            await ApplyVideoSizeAsync();
            return;
        }

        _videoScale = normalized;
        await ApplyVideoSizeAsync();
    }

    private Task ApplyVideoSizeAsync() =>
        JS.InvokeVoidAsync("h265App.setWatchVideoScale", _videoScale).AsTask();

    private void OnBufferingInput(ChangeEventArgs args)
    {
        if (TryUpdateBufferingLevel(args))
        {
            _bufferingDirty = true;
        }
    }

    private async Task OnBufferingCommittedAsync(ChangeEventArgs args)
    {
        if (TryUpdateBufferingLevel(args))
        {
            _bufferingDirty = true;
        }

        if (!_bufferingDirty)
        {
            return;
        }

        _bufferingDirty = false;

        if (!_hasLoadedPlayer || !SupportsAdjustableBuffering)
        {
            return;
        }

        await GoAsync();
    }

    private bool TryUpdateBufferingLevel(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var parsed))
        {
            return false;
        }

        var normalized = Math.Clamp(parsed, 1, 5);
        if (normalized == _bufferingLevel)
        {
            return false;
        }

        _bufferingLevel = normalized;
        return true;
    }

    private PlaybackWatchdogOptions? BuildPlaybackWatchdogOptions()
    {
        if (_preset is null || !SupportsPlaybackWatchdog(_preset.SourceType))
        {
            return null;
        }

        var checkIntervalSeconds = NormalizeWatchdogCheckIntervalSeconds(
            _preset.WatchdogCheckIntervalSeconds ?? GetDefaultWatchdogCheckIntervalSeconds(_preset.SourceType));

        return new PlaybackWatchdogOptions
        {
            Enabled = _preset.WatchdogEnabled ?? true,
            CheckIntervalSeconds = checkIntervalSeconds,
            StallSeconds = NormalizeWatchdogStallSeconds(
                checkIntervalSeconds,
                _preset.WatchdogStallSeconds ?? GetDefaultWatchdogStallSeconds(_preset.SourceType))
        };
    }

    private static bool SupportsPlaybackWatchdog(string? sourceType) =>
        string.Equals(sourceType, "direct", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(sourceType, "hls", StringComparison.OrdinalIgnoreCase);

    private static int GetDefaultWatchdogCheckIntervalSeconds(string? sourceType) =>
        string.Equals(sourceType, "hls", StringComparison.OrdinalIgnoreCase) ? 5 : 3;

    private static int GetDefaultWatchdogStallSeconds(string? sourceType) =>
        string.Equals(sourceType, "hls", StringComparison.OrdinalIgnoreCase) ? 15 : 10;

    private static int NormalizeWatchdogCheckIntervalSeconds(int value) =>
        Math.Clamp(value, 1, 30);

    private static int NormalizeWatchdogStallSeconds(int checkIntervalSeconds, int stallSeconds) =>
        Math.Max(Math.Clamp(stallSeconds, 2, 120), NormalizeWatchdogCheckIntervalSeconds(checkIntervalSeconds) + 1);

    [JSInvokable]
    public Task OnDirectStatusChanged(string status)
    {
        _status = status;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDirectLog(string message)
    {
        _logText = string.IsNullOrWhiteSpace(_logText)
            ? message
            : $"{_logText}{Environment.NewLine}{message}";
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("h265App.releaseWatchVideoSize");
        }
        catch
        {
        }
    }

    private sealed class DirectLoadResult
    {
        public string ProxyUrl { get; set; } = string.Empty;
        public string Status { get; set; } = "Idle";
    }

    private sealed class HlsLoadResult
    {
        public string ResolvedUrl { get; set; } = string.Empty;
        public string Framework { get; set; } = "Idle";
        public string Status { get; set; } = "Idle";
    }

    private sealed class PlaybackWatchdogOptions
    {
        public bool Enabled { get; set; }
        public int CheckIntervalSeconds { get; set; }
        public int StallSeconds { get; set; }
    }

    private sealed class StartRequest
    {
        public FfmpegSettings Settings { get; set; } = new();
    }

    private sealed class ApiEnvelope<T>
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Text { get; set; } = string.Empty;
        public T? Json { get; set; }
    }

    private sealed class TranscoderStatusResponse
    {
        public bool IsRunning { get; set; }
        public List<string> Logs { get; set; } = [];
    }

    private sealed class FfmpegSettings
    {
        public string FfmpegPath { get; set; } = string.Empty;
        public string InputUrl { get; set; } = string.Empty;
        public string VideoCodec { get; set; } = "libx264";
        public string Preset { get; set; } = "browser-safe-h264";
        public string AudioMode { get; set; } = "none";
        public bool AutoRestart { get; set; } = true;
        public bool AutoPlay { get; set; } = true;
        public bool AutoStart { get; set; }
    }
}
