substitutions:
  device_name: sky-stream-ir
  friendly_name: "Sky Stream Remote"

esphome:
  name: ${device_name}
  friendly_name: ${friendly_name}

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:

api:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  ap:
    ssid: "Sky-Stream-IR Fallback"
    password: "changeme123"

captive_portal:

# ============================================================
# CUSTOM STANDALONE WEB REMOTE
# ============================================================
# The ESP32 serves the page; the browser pulls JS/CSS from GitHub.
# Do not copy sky_remote.js / sky_remote.css onto the device.
# Use jsDelivr (not raw.githubusercontent.com) so the CSS MIME type works.
#
# Browse to:
#   http://sky-stream-ir.local/
#
web_server:
  port: 80
  version: 3
  css_url: "https://cdn.jsdelivr.net/gh/itdevconsulting/HomeSkyQLiveStreamingPlayer@main/SkyStreamRemote/sky_remote.css"
  js_url: "https://cdn.jsdelivr.net/gh/itdevconsulting/HomeSkyQLiveStreamingPlayer@main/SkyStreamRemote/sky_remote.js"


# ESP32E-N4 IR board hardware power.
# This MUST remain on or the onboard IR TX/RX circuitry is unpowered.
switch:
  - platform: gpio
    pin: GPIO21
    id: ir_system_power
    name: "IR System Power"
    restore_mode: ALWAYS_ON
    entity_category: diagnostic

# Onboard IR transmitter
remote_transmitter:
  id: ir_tx
  pin: GPIO4
  carrier_duty_percent: 50%
  rmt_symbols: 256

# Onboard IR receiver.
# Useful for learning/testing other remote commands.
remote_receiver:
  id: ir_rx
  pin:
    number: GPIO14
    inverted: true
  dump: all
  rmt_symbols: 256

button:
  - platform: template
    name: "sky_stream_power"
    id: sky_stream_power
    icon: mdi:power
    on_press:
      - remote_transmitter.transmit_pronto:
          data: "0000 006C 0022 0002 0157 00AC 0015 0016 0015 0016 0015 0041 0015 0016 0015 0016 0015 0016 0015 0016 0015 0016 0015 0041 0015 0041 0015 0016 0015 0041 0015 0041 0015 0041 0015 0041 0015 0041 0015 0041 0015 0016 0015 0041 0015 0041 0015 0016 0015 0041 0015 0016 0015 0041 0015 0016 0015 0041 0015 0016 0015 0016 0015 0041 0015 0016 0015 0041 0015 0016 0015 060E 0157 0056 0015 0E58"

